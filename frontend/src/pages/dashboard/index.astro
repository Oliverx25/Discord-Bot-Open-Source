---
export const prerender = true;

import type { HealthResponse } from "@adobos/shared";
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { DashboardHomeIsland } from "../../components/providers/islands";

const API_ORIGIN = import.meta.env.INTERNAL_API_URL ?? "http://127.0.0.1:3000";

let initialHealth: HealthResponse | null = null;
try {
  const response = await fetch(`${API_ORIGIN}/api/health`, {
    headers: { Accept: "application/json" },
  });
  if (response.ok) {
    initialHealth = (await response.json()) as HealthResponse;
  }
} catch {
  initialHealth = null;
}
---

<DashboardLayout
  title="Dashboard"
  description="Modules, status and the control center for this server."
>
  <DashboardHomeIsland client:load initialHealth={initialHealth} />
</DashboardLayout>
