---
import { NavItem } from "@/components/nav/NavItem";
import { visibleDashboardNav } from "@/lib/nav";
import { isNavActive, normalizePath } from "@/lib/navPath";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const path = normalizePath(currentPath);
---

<nav
  id="tobot-sidebar-nav"
  class="flex flex-1 flex-col gap-3.5 overflow-y-auto px-2.5 py-3"
  aria-label="Dashboard navigation"
>
  {
    visibleDashboardNav().map((category) => (
      <section data-nav-category={category.id} aria-labelledby={`${category.id}-label`}>
        <h2
          id={`${category.id}-label`}
          class="px-2.5 pb-1.5 font-mono text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--text-muted)]"
        >
          {category.label}
        </h2>
        <ul class="space-y-0.5">
          {category.items.map((item) => (
            <NavItem
              label={item.label}
              href={item.href}
              icon={item.icon}
              soon={item.soon}
              active={isNavActive(item.href, path)}
            />
          ))}
        </ul>
      </section>
    ))
  }
</nav>

<script is:inline>
  (function () {
    var nav = document.getElementById("tobot-sidebar-nav");
    if (!nav) return;
    var key = "tobot.sidebar-nav-scroll";
    try {
      var y = sessionStorage.getItem(key);
      if (y) nav.scrollTop = Number(y);
    } catch (e) {}
    nav.addEventListener(
      "scroll",
      function () {
        try {
          sessionStorage.setItem(key, String(nav.scrollTop));
        } catch (e) {}
      },
      { passive: true },
    );
  })();
</script>
