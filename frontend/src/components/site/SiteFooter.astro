---
interface Props {
  signedIn?: boolean;
}

const { signedIn = false } = Astro.props;
---

<footer class="border-t border-border py-10">
  <div
    class="mx-auto flex max-w-[1200px] flex-wrap items-center justify-between gap-8 px-6"
  >
    <span class="font-display text-xl font-extrabold tracking-tight">
      tobot<span class="text-primary">.</span>
    </span>
    <div class="flex gap-6 text-xs text-muted-foreground">
      <a href="#modules" class="hover:text-foreground">Modules</a>
      <a href="#pricing" class="hover:text-foreground">Pricing</a>
      <a href={signedIn ? "/dashboard" : "/auth/discord"} class="hover:text-foreground">
        Dashboard
      </a>
    </div>
    <span
      class="font-mono text-[11px] uppercase tracking-[0.16em] text-muted-foreground"
    >
      Built for the server that outgrew six bots.
    </span>
  </div>
</footer>
