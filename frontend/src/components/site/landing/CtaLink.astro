---
import { Button, type ButtonProps } from "@/components/ui/button";

interface Props {
  href: string;
  variant?: ButtonProps["variant"];
  size?: ButtonProps["size"];
  class?: string;
  reload?: boolean;
}

const { href, variant, size, class: className, reload } = Astro.props;
---

<Button
  href={href}
  variant={variant}
  size={size}
  className={className}
  reload={reload}
>
  <slot />
</Button>
