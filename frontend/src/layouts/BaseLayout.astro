---
import { ClientRouter } from "astro:transitions";
import "../styles/globals.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "tobot.",
  description = "Moderation, logs, welcomes, levels and economy from one bot — one subscription for every server you run.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <script is:inline>
      (function () {
        function applyThemeFromStorage() {
          try {
            var key = "tobot-theme";
            var stored =
              localStorage.getItem(key) || localStorage.getItem("adobos-theme");
            var preference =
              stored === "light" || stored === "dark" || stored === "system"
                ? stored
                : "dark";
            var dark =
              preference === "dark" ||
              (preference === "system" &&
                window.matchMedia("(prefers-color-scheme: dark)").matches);
            document.documentElement.classList.toggle("dark", dark);
            document.documentElement.dataset.theme = dark ? "dark" : "light";
          } catch (_) {
            /* ignore */
          }
        }
        function applySignedInHint() {
          try {
            var signedIn = document.cookie.split(";").some(function (part) {
              return part.trim().indexOf("tobot_signed_in=") === 0;
            });
            if (signedIn) document.documentElement.dataset.signedIn = "1";
            else delete document.documentElement.dataset.signedIn;
          } catch (_) {
            /* ignore */
          }
        }
        applyThemeFromStorage();
        applySignedInHint();
        document.addEventListener("astro:page-load", applyThemeFromStorage);
        document.addEventListener("astro:after-swap", applyThemeFromStorage);
        document.addEventListener("astro:page-load", applySignedInHint);
        document.addEventListener("astro:after-swap", applySignedInHint);
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=Karla:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body class="min-h-dvh bg-background text-foreground">
    <slot />
  </body>
</html>
