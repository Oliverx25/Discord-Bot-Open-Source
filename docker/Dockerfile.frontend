# syntax=docker/dockerfile:1
# Panel Astro estático + nginx (proxy /api /auth /uploads → backend).
#
# Fase 8 (PLAN_FINAL_2026.md): ambas imágenes base fijadas por digest — ver
# Dockerfile (prod backend) para cómo refrescarlas. `nginx:1.27-alpine`
# traía libcrypto3/libssl3 vulnerables (CVE-2026-31789, CRITICAL, heap
# buffer overflow en X.509); `1.29-alpine` ya trae OpenSSL parcheado
# (verificado con `trivy image --severity CRITICAL --ignore-unfixed`: 0
# hallazgos) sin cambiar nada de `docker/nginx.conf`.

FROM node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e AS build
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY packages/shared/package.json ./packages/shared/
COPY backend/package.json ./backend/
COPY frontend/package.json ./frontend/
RUN pnpm install --frozen-lockfile --filter @adobos/frontend...

COPY tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY frontend ./frontend
RUN pnpm --filter @adobos/shared build && pnpm --filter @adobos/frontend build

FROM nginx:1.29-alpine@sha256:5616878291a2eed594aee8db4dade5878cf7edcb475e59193904b198d9b830de
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/frontend/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
